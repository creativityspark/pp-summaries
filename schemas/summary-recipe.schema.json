{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/creativityspark/pp-summaries/schemas/summary-recipe.schema.json",
  "title": "Summary Recipe",
  "description": "Declarative contract used to materialize a governed Power Automate summary flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "prompt", "output", "trigger"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "fields", "relationships"],
      "properties": {
        "entity": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["entity"],
            "properties": {
              "entity": { "type": "string", "minLength": 1 },
              "windowDays": { "type": "integer", "minimum": 1 },
              "maxRecords": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "model", "inputs"],
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "field", "cache", "preserveHistory"],
      "properties": {
        "entity": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "cache": { "type": "boolean" },
        "preserveHistory": { "type": "boolean" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns"],
      "properties": {
        "type": { "type": "string", "enum": ["dataverse.update", "schedule.daily", "manual"] },
        "columns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
